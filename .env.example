# ============================================
# MazoIglesias — Variables de entorno
# ============================================
# Copia este archivo a .env.local y rellena los valores.
# NUNCA subas .env.local al repositorio.
# ============================================

# --- Base de datos (Vercel Postgres / Neon) ---
POSTGRES_PRISMA_URL="postgresql://user:password@host:5432/mazoiglesias?schema=public"
POSTGRES_URL_NON_POOLING="postgresql://user:password@host:5432/mazoiglesias?schema=public"

# --- NextAuth.js ---
# Genera un secreto seguro con: openssl rand -base64 32
NEXTAUTH_SECRET="CAMBIA_ESTO_POR_UN_SECRET_SEGURO_DE_32_CHARS"
NEXTAUTH_URL="http://localhost:3000"

# --- Vercel Blob (almacenamiento de fotos) ---
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_XXXXX"
